{
  "targets": [
    {
      "target_name": "naudiodon",
      "sources": [
        "src/naudiodonUtil.cc",
        "src/naudiodon.cc",
        "src/GetDevices.cc",
        "src/GetHostAPIs.cc",
        "src/AudioIO.cc",
        "src/PaContext.cc"
      ],
      "include_dirs": [
        "/data/data/com.termux/files/usr/include"
      ],
      "cflags_cc!": [
        "-fno-rtti",
        "-fno-exceptions"
      ],
      "cflags_cc": [
        "-std=c++11",
        "-fexceptions"
      ],
      "link_settings": {
        "libraries": [
          "-lportaudio"
        ],
        "ldflags": [
          "-L/data/data/com.termux/files/usr/lib",
          "-Wl,-rpath,/data/data/com.termux/files/usr/lib"
        ]
      }
    }
  ]
}
